# Snippen Doorman Service Configuration
# Copy this file to .env and fill in the values

# Service Configuration
SNIPPEN_DOORMAN_LOG_LEVEL=INFO
SNIPPEN_DOORMAN_DATABASE_PATH=data/doorman.db

# Yale Doorman Access Module
SNIPPEN_DOORMAN_MODULE_URL=http://localhost:8080
SNIPPEN_DOORMAN_MODULE_TOKEN=your-module-token

# Snippen Booking Platform Integration
SNIPPEN_DOORMAN_API_URL=https://your-snippen-instance.com/wp-json
SNIPPEN_DOORMAN_API_TOKEN=your-api-token

# Synchronization
SNIPPEN_DOORMAN_SYNC_ENABLED=true
SNIPPEN_DOORMAN_SYNC_INTERVAL=5.0
SNIPPEN_DOORMAN_SYNC_TIMEOUT=10.0
