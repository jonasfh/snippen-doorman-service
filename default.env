# Snippen Doorman Service Configuration
# Copy this file to .env and fill in the values

# Service Configuration
SNIPPEN_DOORMAN_LOG_LEVEL=INFO
SNIPPEN_DOORMAN_STORAGE_TYPE=sqlite
SNIPPEN_DOORMAN_DATABASE_PATH=data/doorman.db
SNIPPEN_DOORMAN_JSON_PATH=data/reservations.json

# Yale Doorman Access Module & BLE
SNIPPEN_DOORMAN_BLE_ADDRESS=AA:BB:CC:DD:EE:FF
SNIPPEN_DOORMAN_BLE_KEY=0123456789abcdef0123456789abcdef
SNIPPEN_DOORMAN_BLE_SLOT=1

# Yale Doorman Guest Slot Allocation (shielding slots 0-2 for Yale Home admin)
SNIPPEN_GUEST_SLOT_MIN=3
SNIPPEN_GUEST_SLOT_MAX=9

# JIT PIN Provisioning & Scheduling
SNIPPEN_PIN_LEAD_TIME_MINUTES=60
SNIPPEN_PIN_GRACE_PERIOD_MINUTES=15
SNIPPEN_SCHEDULER_INTERVAL_SECONDS=60.0

# Snippen Booking Platform Integration (WordPress REST API - spec #351)
SNIPPEN_DOORMAN_API_URL=https://vestreholmensameie.no/wp-json/snippen/v1/door
SNIPPEN_DOORMAN_API_TOKEN=your-api-token
SNIPPEN_DOORMAN_SYNC_INTERVAL=60.0
SNIPPEN_DOORMAN_SYNC_TIMEOUT=10.0
SNIPPEN_DOORMAN_AUTO_GENERATE_PIN=true
